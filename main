#!/bin/bash
watch -n 1 -t "
  # 1. 采集数据
  UPTIME=\$(uptime -p | sed 's/up //')
  IP_ADDR=\$(hostname -I | awk '{print \$1}')
  
  # 兼容性判断：使用单等号 = 代替 ==
  if ping -c 1 -W 1 223.5.5.5 > /dev/null 2>&1; then
      NET_STR=\"ONLINE\"
      NET_COL=\"\033[1;32m\"
  else
      NET_STR=\"OFFLINE\"
      NET_COL=\"\033[1;31m\"
  fi
  
  CPU_T=\$((\$(cat /sys/class/thermal/thermal_zone0/temp) / 1000))
  GPU_T=\$((\$(cat /sys/class/thermal/thermal_zone1/temp) / 1000))
  FREQ_L=\$((\$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq) / 1000))
  FREQ_B=\$((\$(cat /sys/devices/system/cpu/cpu4/cpufreq/scaling_cur_freq) / 1000))
  CPU_USAGE_VAL=\$(top -bn1 | grep \"Cpu(s)\" | awk '{print 100 - \$8}')
  CPU_USAGE=\$(printf \"%.1f%%\" \"\$CPU_USAGE_VAL\")
  
  # CPU 压力条
  CPU_BAR_F=\$(( \$(printf \"%.0f\" \"\$CPU_USAGE_VAL\") / 10 ))
  CPU_BAR=\$(printf \"\033[1;32m%0.s|\033[0m\" \$(seq 1 \$CPU_BAR_F 2>/dev/null) && printf \"\033[1;30m%0.s.\033[0m\" \$(seq 1 \$((10 - \$CPU_BAR_F)) 2>/dev/null))

  # 2. 内存与存储
  MEM_TOTAL=\$(free | grep Mem | awk '{print \$2}')
  MEM_USED=\$(free | grep Mem | awk '{print \$3}')
  MEM_PER=\$((\$MEM_USED * 100 / \$MEM_TOTAL))
  MEM_BAR_FILL=\$((\$MEM_PER / 4))
  MEM_BAR=\$(printf \"\033[1;32m%0.s■\033[0m\" \$(seq 1 \$MEM_BAR_FILL) && printf \"\033[1;30m%0.s-\033[0m\" \$(seq 1 \$((25 - \$MEM_BAR_FILL))))
  MEM_STR=\$(free -m | grep Mem | awk '{printf \"%d MB / %d MB\", \$3, \$2}')

  DISK_PATH=\"/mnt/home\"
  DISK_TOTAL=\$(df -h \$DISK_PATH | awk 'NR==2{print \$2}')
  DISK_USED=\$(df -h \$DISK_PATH | awk 'NR==2{print \$3}')
  DISK_PER=\$(df -h \$DISK_PATH | awk 'NR==2{print \$5}' | tr -d '%')
  DISK_BAR_FILL=\$((\$DISK_PER / 4))
  DISK_COLOR=\"\033[1;32m\"; [ \$DISK_PER -gt 70 ] && DISK_COLOR=\"\033[1;33m\"; [ \$DISK_PER -gt 90 ] && DISK_COLOR=\"\033[1;31m\"
  DISK_BAR=\$(printf \"\${DISK_COLOR}%0.s■\033[0m\" \$(seq 1 \$DISK_BAR_FILL) && printf \"\033[1;30m%0.s-\033[0m\" \$(seq 1 \$((25 - \$DISK_BAR_FILL))))

  # 3. Docker 监控
  DOCKER_RUNNING=\$(docker ps -q | wc -l)
  IMG_TOTAL=\$(docker images -q | wc -l)
  IMG_INUSE=\$(docker ps -a --format '{{.Image}}' | sort -u | wc -l)
  IMG_COLOR=\"\033[1;32m\"; [ \$IMG_INUSE -lt \$IMG_TOTAL ] && IMG_COLOR=\"\033[1;33m\"
  D_MEM_RAW=\$(cat /sys/fs/cgroup/memory/docker/memory.usage_in_bytes 2>/dev/null || cat /sys/fs/cgroup/system.slice/docker.service/memory.current 2>/dev/null)
  DOCKER_MEM=\$(echo \"\${D_MEM_RAW:-0}\" | awk '{ if(\$1>=1048576) printf \"%.1f MB\", \$1/1048576; else printf \"%.1f KB\", \$1/1048576 }')

  # 4. 网络监控 - 修复版本
  # 检查接口是否存在
  if ! grep -q \"eth0:\" /proc/net/dev 2>/dev/null; then
    # 如果eth0不存在，尝试获取第一个非lo接口
    INTERFACE=\$(grep : /proc/net/dev | grep -v lo: | head -1 | cut -d: -f1 | tr -d ' ')
  else
    INTERFACE=\"eth0\"
  fi
  
  # 获取当前网络统计
  if [ -n \"\$INTERFACE\" ] && grep -q \"\$INTERFACE:\" /proc/net/dev 2>/dev/null; then
    CUR_RX=\$(grep \"\$INTERFACE:\" /proc/net/dev | awk '{print \$2}')
    CUR_TX=\$(grep \"\$INTERFACE:\" /proc/net/dev | awk '{print \$10}')
  else
    CUR_RX=0
    CUR_TX=0
  fi
  
  # 格式化总流量显示
  TOTAL_RX=\$(echo \"\$CUR_RX\" | awk '{ if(\$1>=1073741824) printf \"%.2f GB\", \$1/1073741824; else if(\$1>=1048576) printf \"%.1f MB\", \$1/1048576; else printf \"%.1f KB\", \$1/1024 }')
  TOTAL_TX=\$(echo \"\$CUR_TX\" | awk '{ if(\$1>=1073741824) printf \"%.2f GB\", \$1/1073741824; else if(\$1>=1048576) printf \"%.1f MB\", \$1/1048576; else printf \"%.1f KB\", \$1/1024 }')

  # 网络速度计算文件路径
  LAST_FILE=\"/tmp/net_stat_\$INTERFACE\"
  SPD_RX=\"0.0 KB/s\"
  SPD_TX=\"0.0 KB/s\"
  
  # 计算网络速度
  if [ -f \"\$LAST_FILE\" ]; then
    # 读取上次的值
    read L_RX L_TX L_TIME < \"\$LAST_FILE\" 2>/dev/null || L_RX=0 L_TX=0 L_TIME=0
    
    # 获取当前时间戳
    CURRENT_TIME=\$(date +%s)
    
    # 如果文件存在且时间戳有效
    if [ -n \"\$L_RX\" ] && [ -n \"\$L_TX\" ] && [ -n \"\$L_TIME\" ]; then
      # 计算时间差
      TIME_DIFF=\$((CURRENT_TIME - L_TIME))
      
      # 避免除零错误
      if [ \"\$TIME_DIFF\" -gt 0 ] 2>/dev/null; then
        # 计算速度 (字节/秒)
        RX_SPEED=\$(( (CUR_RX - L_RX) / TIME_DIFF ))
        TX_SPEED=\$(( (CUR_TX - L_TX) / TIME_DIFF ))
        
        # 转换为 KB/s
        SPD_RX=\$(echo \"\$RX_SPEED\" | awk '{printf \"%.1f KB/s\", \$1/1024}')
        SPD_TX=\$(echo \"\$TX_SPEED\" | awk '{printf \"%.1f KB/s\", \$1/1024}')
      fi
    fi
  fi
  
  # 保存当前值和时间戳
  echo \"\$CUR_RX \$CUR_TX \$(date +%s)\" > \"\$LAST_FILE\" 2>/dev/null

  # 5. 打印界面
  COL=\$(tput cols)
  OFFSET=\$(( (COL - 56) / 2 ))
  [ \$OFFSET -lt 0 ] && OFFSET=0
  SP=\$(printf '%*s' \"\$OFFSET\" '')
  
  printf \"\${SP}\033[1;36m========================================================\033[0m\n\"
  printf \"\${SP}\033[1;33m             NanoPC-T4 智能监控中心 (V8.7)            \033[0m\n\"
  printf \"\${SP}\033[1;36m========================================================\033[0m\n\"
  
  # 修复字体重叠问题 - 使用固定宽度格式化
  printf \"\${SP}  内网地址 : \033[1;37m%-15s\033[0m   外网状态 : %b%-7s\033[0m\n\" \"\$IP_ADDR\" \"\$NET_COL\" \"\$NET_STR\"
  printf \"\${SP}  运行时间 : \033[1;37m%-30s\033[0m\n\" \"\$UPTIME\"
  printf \"\${SP}  CPU 负载 : \033[1;32m%-8s\033[0m          压力条 : [\$CPU_BAR]\n\" \"\$CPU_USAGE\"
  
  printf \"\${SP}\033[1;36m--------------------------------------------------------\033[0m\n\"
  printf \"\${SP}  核心温度 : \033[1;31m%-11s\033[0m  显卡温度 : \033[1;35m%d°C\033[0m\n\" \"\${CPU_T}°C\" \"\$GPU_T\"
  printf \"\${SP}  小核频率 : \033[1;37m%-11s\033[0m 大核频率 : \033[1;37m%d MHz\033[0m\n\" \"\${FREQ_L} MHz\" \"\$FREQ_B\"
  
  printf \"\${SP}\033[1;36m--------------------------------------------------------\033[0m\n\"
  printf \"\${SP}  内存资源 : [ %s ] %d%%\n\" \"\$MEM_BAR\" \"\$MEM_PER\"
  printf \"\${SP}  内存详情 : \033[1;37m%-30s\033[0m\n\" \"\$MEM_STR\"
  printf \"\${SP}  存储资源 : [ %s ] %d%%\n\" \"\$DISK_BAR\" \"\$DISK_PER\"
  printf \"\${SP}  存储详情 : \033[1;37m%-15s\033[0m / %-10s\033[0m\n\" \"\$DISK_USED\" \"\$DISK_TOTAL\"
  
  printf \"\${SP}\033[1;36m--------------------------------------------------------\033[0m\n\"
  printf \"\${SP}  容器运行 : \033[1;32m%-11s\033[0m  容器内存 : \033[1;37m%s\033[0m\n\" \"\$DOCKER_RUNNING Running\" \"\$DOCKER_MEM\"
  printf \"\${SP}  镜像统计 : \${IMG_COLOR}%-11s\033[0m  本地镜像 : \033[1;37m%d\033[0m\n\" \"\$IMG_INUSE In-Use\" \"\$IMG_TOTAL\"
  
  printf \"\${SP}\033[1;36m--------------------------------------------------------\033[0m\n\"
  printf \"\${SP}  下载状态 : \033[1;32m%-12s\033[0m (累计: \033[1;37m%s\033[0m)\n\" \"\${SPD_RX}\" \"\$TOTAL_RX\"
  printf \"\${SP}  上传状态 : \033[1;34m%-12s\033[0m (累计: \033[1;37m%s\033[0m)\n\" \"\${SPD_TX}\" \"\$TOTAL_TX\"
  
  printf \"\${SP}\033[1;36m========================================================\033[0m\n\"
  printf \"\${SP}\033[1;32m                 按 Ctrl+C 退出监控中心                 \033[0m\n\"
"
